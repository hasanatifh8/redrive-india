# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Admin panel login (/admin). Required in production.
ADMIN_PASSWORD=change-me
# Random string of 32+ characters used to sign admin sessions. e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Database — leave empty locally to use a local SQLite file (local.db).
# On Vercel: set these to ONE permanent Turso database (Turso → your database → Connect).
# Do NOT rely on the per-deployment TURSO_DATABASE_URL some Turso/Vercel setups inject —
# it creates a new empty database on every deploy. The build refuses to deploy on one.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Image storage — leave empty locally (images go to .uploads/).
# On Vercel: create a Blob store (Storage tab) and connect it; this is filled in for you.
BLOB_READ_WRITE_TOKEN=

# Public URL of the site, used for sitemap/SEO. e.g. https://redriveindia.in
NEXT_PUBLIC_SITE_URL=
